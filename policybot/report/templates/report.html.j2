<article lang="fr">
  <style>
    body { font-family: Arial, sans-serif; color: #17202a; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #c9d2dc; padding: .55rem; vertical-align: top; }
    th { background: #eaf2f8; text-align: left; }
    .warning { border-left: 5px solid #c0392b; background: #fdedec; padding: .8rem; }
    .category td { background: #f4f6f7; }
    .risk { text-align: center; font-weight: bold; }
    .source { margin: .3rem 0; }
    footer { margin-top: 1.5rem; color: #566573; }
  </style>
  <h1>Rapport de recommandation - PolicyBot</h1>
  <p class="warning"><strong>PolicyBot fournit des constats et des niveaux de risque proposés; il n'autorise pas.</strong>
    La partie C doit être complétée et validée par l'autorité désignée.</p>

  <h2>Identification</h2>
  <table>
    <tr><th>Numéro de demande</th><td>{{ state.request.numero }}</td></tr>
    <tr><th>Demandeur</th><td>{{ state.request.demandeur }}</td></tr>
    <tr><th>Unité</th><td>{{ state.request.unite }}</td></tr>
    <tr><th>Outil évalué</th><td>{{ tool.name if tool else "" }}</td></tr>
  </table>

  {% macro findings_table(groups) %}
  <table>
    <thead><tr>
      <th>Critère</th><th>Description / question</th><th>Risque inhérent</th>
      <th>Mesures de mitigation</th><th>Risque résiduel</th><th>Responsable</th>
      <th>Observations / constats</th>
    </tr></thead>
    <tbody>
    {% for category, rows in groups %}
      <tr class="category"><td colspan="7"><strong>{{ category }}</strong></td></tr>
      {% for row in rows %}
      <tr>
        <td>{{ row.criterion }}</td>
        <td>{{ row.description }}</td>
        <td class="risk">{{ row.finding.inherent_risk if row.finding else "" }}</td>
        <td></td><td></td><td></td>
        <td>
          {% if row.finding %}
            {% if row.finding.outcome == "ok" and row.finding.answer %}
              <p>{{ row.finding.answer }}</p>
              {% if row.finding.justification %}<p><strong>Justification :</strong> {{ row.finding.justification }}</p>{% endif %}
            {% else %}<p>Aucune source probante trouvée.</p>{% endif %}
            {% for citation in row.finding.citations %}
              <div class="source">{{ citation.source_type }} —
                <a href="{{ citation.deep_link or citation.url }}">« {{ citation.text }} »</a>
              </div>
            {% endfor %}
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    {% endfor %}
    </tbody>
  </table>
  {% endmacro %}

  <h2>Partie A - Analyse des risques du produit (ARP)</h2>
  {{ findings_table(partie_a) }}

  <h2>Partie B - Évaluation des risques par usage</h2>
  {% if state.usages %}
    {% for usage in state.usages %}
      <h3>Usage {{ loop.index }} : {{ usage.description }}</h3>
      {{ findings_table(partie_b) }}
    {% endfor %}
  {% else %}
    {{ findings_table(partie_b) }}
  {% endif %}

  <h2>Partie C - Synthèse et décision</h2>
  <p>Section réservée à l'autorité désignée. Aucun résultat n'est calculé automatiquement par PolicyBot.</p>
  <table>
    <tr><th>Niveau de risque global</th><td></td></tr>
    <tr><th>EFVP-R requise</th><td></td></tr>
    <tr><th>Recommandation préliminaire</th><td></td></tr>
    <tr><th>Conditions / restrictions proposées</th><td></td></tr>
  </table>

  {% if sources %}
  <h2>Sources contractuelles consultées</h2>
  <table>
    <tr><th>Type</th><th>Source</th><th>Collectée le</th><th>Date d'effet</th></tr>
    {% for source in sources %}
    <tr>
      <td>{{ source.source_type }}</td>
      <td><a href="{{ source.url }}">{{ source.title or source.url }}</a></td>
      <td>{{ source.collected_at }}</td><td>Non précisée</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  <footer>
    Coût total estimé des recherches Exa : {{ "%.4f"|format(total_cost) }} $ US.
    Rapport généré par PolicyBot; validation humaine obligatoire.
  </footer>
</article>
