{# policybot/web/templates/wizard_outil.html.j2 #}
{% extends "_layout.html.j2" %}
{% block content %}
<div class="kicker">Étape 1 · Ton outil</div>
<h1>Quel outil d'IA générative comptes-tu utiliser&nbsp;?</h1>
<div class="assist"><img src="/static/friendly.png" alt=""> Choisis un outil connu ou tape son nom.</div>
<form method="post" action="/wizard/outil" id="wizard-form">
  {% if errors %}<div class="form-errors" role="alert">Corrigez les champs indiques ci-dessous.</div>{% endif %}
  <div class="chips">
    {% for name in known_tools %}
    <label class="chip"><input type="radio" name="tool_name" value="{{ name }}" {% if state.tool_name == name %}checked{% endif %}> {{ name }}</label>
    {% endfor %}
  </div>
  <label class="freefield">Autre outil :
    <input type="text" name="tool_name_other" value="{% if state.tool_name not in known_tools %}{{ state.tool_name }}{% endif %}" placeholder="Nom de l'outil" aria-describedby="tool_name-error">
  </label>
  {% if errors.tool_name %}<p class="field-error" id="tool_name-error">{{ errors.tool_name }}</p>{% endif %}
  <label class="freefield">Nom du demandeur :
    <input type="text" name="demandeur" value="{{ state.demandeur }}" required aria-describedby="demandeur-error" oninvalid="this.setCustomValidity('Indiquez le nom du demandeur.')" oninput="this.setCustomValidity('')">
  </label>
  {% if errors.demandeur %}<p class="field-error" id="demandeur-error">{{ errors.demandeur }}</p>{% endif %}
  <label class="freefield">Unite administrative :
    <input type="text" name="unite" value="{{ state.unite }}" required aria-describedby="unite-error" oninvalid="this.setCustomValidity('Indiquez l'unite administrative du demandeur.')" oninput="this.setCustomValidity('')">
  </label>
  {% if errors.unite %}<p class="field-error" id="unite-error">{{ errors.unite }}</p>{% endif %}
  <label class="freefield">Version / plan tarifaire (optionnel) :
    <input type="text" name="version_plan_tarifaire" value="{{ state.version_plan_tarifaire }}" placeholder="ex. Plan Plus, Entreprise">
  </label>
  <details>
    <summary>Préciser l’offre contractuelle</summary>
    <label class="freefield">Mode de déploiement :
      <select name="deployment_mode">
        <option value="">Déduire du type d’outil</option>
        {% for value, label in [("public_saas", "Service public"), ("managed_saas", "Service institutionnel géré"), ("sovereign_hosted", "Hébergement souverain"), ("government_hosted", "Hébergement gouvernemental"), ("on_premise", "Sur site")] %}
        <option value="{{ value }}" {% if state.deployment_mode == value %}selected{% endif %}>{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="freefield">Type de contrat :
      <select name="contract_type">
        <option value="">Déduire du plan</option>
        {% for value, label in [("consumer_terms", "Conditions grand public"), ("institutional_agreement", "Contrat institutionnel"), ("government_agreement", "Entente gouvernementale"), ("dpa", "Entente de traitement des données")] %}
        <option value="{{ value }}" {% if state.contract_type == value %}selected{% endif %}>{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="freefield">Version du contrat :
      <input type="text" name="contract_version" value="{{ state.contract_version }}" placeholder="ex. DPA-2026-07">
    </label>
    <label class="freefield">Date d’effet du contrat :
      <input type="date" name="contract_effective_date" value="{{ state.contract_effective_date }}">
    </label>
  </details>
  <div class="foot"><span></span><button class="next" type="submit">Continuer &rarr;</button></div>
</form>
<section class="test-scenarios" aria-labelledby="test-scenarios-title">
  <div class="test-scenarios-heading">
    <div>
      <div class="kicker">Mode démonstration</div>
      <h2 id="test-scenarios-title">Préremplir un scénario de test</h2>
    </div>
    <p>Choisis un cas, puis parcours ou modifie les réponses avant de générer le résultat.</p>
  </div>
  <div class="test-scenario-grid">
    {% for scenario in demo_scenarios %}
    <form method="post" action="/wizard/test-prefill" class="test-prefill-form">
      <input type="hidden" name="scenario_id" value="{{ scenario.id }}">
      <button class="test-prefill" type="submit">
        <strong>{{ scenario.title }}</strong>
        <span>{{ scenario.description }}</span>
        <small>{{ scenario.expected_result }}</small>
      </button>
    </form>
    {% endfor %}
  </div>
</section>
{% endblock %}



