# Variables d'environnement de PolicyBot.
# Copie ce fichier vers .env et renseigne les deux clés. Ne versionne jamais
# la copie. Seule la CLI en usage console lit .env ; la suite de tests reste
# hors ligne.
#
# Ce fichier ne liste que des variables réellement lues par le code. Toutes
# celles qui sont commentées sont facultatives : une variable laissée vide est
# ignorée, elle ne remplace rien.

# =====================================================================
# Clés d'API — obligatoires
# =====================================================================
# Sans l'une ou l'autre, le lot entier s'arrête avec le code de retour 2.
# PolicyBot ne produit jamais un rapport d'apparence complète dont tous les
# constats seraient vides.

# Classification des données : le seul appel modèle du pipeline.
OPENROUTER_API_KEY=

# Recherche des faits contractuels : une requête par critère recherché (17).
EXA_API_KEY=

# =====================================================================
# Modèle — surcharges facultatives
# =====================================================================
# La configuration normale vit dans configs/policybot.yaml. Ces variables
# l'emportent sur le YAML. Précédence, du plus fort au plus faible :
#   POLICYBOT_LLM_DATA_CLASSIFICATION_<CHAMP>  >  OPENROUTER_<CHAMP>  >  YAML

# Surcharges globales.
# OPENROUTER_MODEL=openai/gpt-5.6-luna
# OPENROUTER_REASONING_EFFORT=low
# OPENROUTER_MAX_TOKENS=2048
# OPENROUTER_TEMPERATURE=0.0
# OPENROUTER_TIMEOUT=60

# Surcharges de la seule tâche modèle existante.
# POLICYBOT_LLM_DATA_CLASSIFICATION_MODEL=
# POLICYBOT_LLM_DATA_CLASSIFICATION_REASONING_EFFORT=
# POLICYBOT_LLM_DATA_CLASSIFICATION_MAX_TOKENS=
# POLICYBOT_LLM_DATA_CLASSIFICATION_TEMPERATURE=
# POLICYBOT_LLM_DATA_CLASSIFICATION_TIMEOUT=

# =====================================================================
# Chemins de remplacement — tests ou déploiement
# =====================================================================
# Chacun remplace un fichier de configs/ par défaut.

# Configuration du modèle (défaut : configs/policybot.yaml).
# POLICYBOT_CONFIG_PATH=C:\chemin\vers\policybot.yaml

# Invites du classificateur (défaut : configs/prompts.yaml).
# POLICYBOT_PROMPTS_PATH=C:\chemin\vers\prompts.yaml

# Catalogue des 35 questions (défaut : configs/formulaire.yaml).
# POLICYBOT_FORMULAIRE_PATH=C:\chemin\vers\formulaire.yaml

# Paramètres Exa communs (défaut : configs/recherche_defaults.yaml).
# POLICYBOT_SEARCH_DEFAULTS_PATH=C:\chemin\vers\recherche_defaults.yaml

# Répertoire des 24 définitions de critères (défaut : configs/recherche_criteres).
# POLICYBOT_CRITERIA_DIR=C:\chemin\vers\recherche_criteres

# =====================================================================
# Gabarits Word et sorties
# =====================================================================
# Les gabarits sont repérés par intitulé de tableau : un gabarit modifié fait
# échouer la demande plutôt que de produire un document incomplet en silence.

# Défaut : documents_reference/SI_-_Fiche_de_qualification.docx
# POLICYBOT_FICHE_TEMPLATE=C:\chemin\vers\fiche.docx

# Défaut : documents_reference/SI_-_Grille_valuation_des_risques.docx
# POLICYBOT_GRILLE_TEMPLATE=C:\chemin\vers\grille.docx

# Répertoire des .docx produits (défaut : output/docx).
# L'option --sortie-docx de « policybot ingerer » l'emporte sur cette valeur.
# POLICYBOT_DOCX_OUTPUT_DIR=C:\chemin\vers\sortie

# =====================================================================
# Journal interne
# =====================================================================
# Par défaut, un fichier horodaté par exécution :
# logs/log_AAAA-MM-JJ_HH-MM-SS_microsecondes.jsonl
# Renseigner un chemin fixe concentre tout dans un seul fichier.
# Le journal ne contient aucun texte libre en clair : mask_text n'enregistre
# qu'une longueur et une empreinte SHA-256.
# POLICYBOT_LOG_PATH=C:\chemin\vers\policybot.jsonl

# =====================================================================
# Google Forms — aucun secret ici
# =====================================================================
# L'authentification ne passe pas par ce fichier. Dépose l'identifiant OAuth
# téléchargé depuis Google Cloud sous credentials.json à la racine du projet ;
# le premier appel réseau ouvre le navigateur pour le consentement puis écrit
# token.json. Les deux fichiers sont ignorés par git.
#
#   pip install -e ".[google]"
#   python scripts/verifier_google.py
