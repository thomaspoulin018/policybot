# PolicyBot environment variables (copy to .env; never commit the copy).

# --- OpenRouter (real LLM calls; without a key, PolicyBot uses FakeLLMProvider) ---
OPENROUTER_API_KEY=
# Non-secret runtime configuration lives in configs/policybot.yaml.
# Optional global overrides: OPENROUTER_MODEL, OPENROUTER_REASONING_EFFORT,
# OPENROUTER_MAX_TOKENS, OPENROUTER_TEMPERATURE, OPENROUTER_TIMEOUT.
# Per-task overrides use POLICYBOT_LLM_<TASK>_<FIELD> for DATA_CLASSIFICATION,
# TOOL_TYPE_DETECTION, MODE_DETECTION and FORM_SUGGESTIONS.
# POLICYBOT_CONFIG_PATH=C:\path\to\policybot.yaml

# ARP cache mode: read_write, refresh, read_only or disabled.
# POLICYBOT_ARP_CACHE_MODE=read_write

# --- Contract-fact search (Exa) ---
# One Exa search runs for every fact. Without a key, every fact remains unknown
# and the interview continues conservatively.
EXA_API_KEY=
# Number of concurrent Exa searches (default: 8).
POLICYBOT_EXA_MAX_WORKERS=8
# Optional alternate directory containing the fact YAML files.
# POLICYBOT_FACT_SEARCH_DIR=C:\path\to\recherche_des_faits

# --- LangSmith tracing (opt-in) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=policybot
# LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# --- Internal trace log ---
# POLICYBOT_LOG_PATH=C:\path\to\policybot.jsonl
