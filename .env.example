# PolicyBot — variables d'environnement (copier vers .env, déjà gitignoré)

# --- OpenRouter (appels LLM réels ; sans clé, PolicyBot utilise le FakeLLMProvider) ---
OPENROUTER_API_KEY=
# Defaults: openai/gpt-5.6-luna and low. Change these without editing code.
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_REASONING_EFFORT=low

# --- Récupération des conditions contractuelles (Partie A / ARP) ---
# "tavily" : recherche web Tavily (5 recherches ciblées, une par famille de critères).
# Vide/absent : fetch direct de l'URL du registre — souvent bloqué en 403 par les
# éditeurs (OpenAI, etc.), avec repli sur le collage manuel.
POLICYBOT_CONTRACT_SEARCH=
TAVILY_API_KEY=

# --- LangSmith : traçabilité des appels LLM (compte perso solo-dev) ---
# Laisser LANGCHAIN_TRACING_V2 vide/absent (ou "false") pour DÉSACTIVER le traçage,
# notamment dans les tests / CI. Mettre "true" pour l'activer.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
# Regroupe les traces dans un projet du tableau de bord LangSmith
LANGCHAIN_PROJECT=policybot
# Optionnel — uniquement pour LangSmith EU/self-hosted (défaut US sinon) :
# LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# Alias modernes équivalents (facultatif) : LANGSMITH_TRACING / LANGSMITH_API_KEY /
# LANGSMITH_PROJECT sont acceptés par les versions récentes de langsmith.
